# Production build: public API origin (no trailing slash). Example: https://keygo-api.onrender.com
# Leave empty for local dev — requests use /api and Vite proxies to your backend.
VITE_API_URL=

# Local dev: where Vite proxies /api (default http://127.0.0.1:3000)
# VITE_DEV_API_PROXY=http://127.0.0.1:3000

# See .env.production.example for a production template.
